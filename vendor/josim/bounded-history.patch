+bool Simulation::bounded_history(Input& iObj, const Matrix& mObj) const {
+    if (iObj.argAnal != AnalysisType::Phase || iObj.transSim.prstart() != 0
+        || iObj.transSim.prfirwindow() != 0 || !iObj.transSim.startup()
+        || !iObj.cli_output_file || iObj.cli_output_file->type() != FileOutputType::Csv
+        || iObj.globalTemp.has_value() || !iObj.output_files.empty() || mObj.relevantTraces.empty()
+        || mObj.relevantTraces.size() > 8 || mObj.relevantIndices.size() > 24
+        || mObj.branchIndex <= 0 || mObj.branchIndex > 80 || mObj.nm.size() > 16
+        || iObj.netlist.expNetlist.size() > 32 || !mObj.components.mutualinductances.empty()) { return false; }
+    if (!std::isfinite(iObj.transSim.prstep()) || iObj.transSim.prstep() <= 0
+        || iObj.transSim.tstop() / iObj.transSim.prstep() > Results::rowLimit) { return false; }
+    for (const auto& line : iObj.netlist.expNetlist) {
+        const auto& tokens = line.first;
+        if (tokens.empty() || tokens.front().empty()) { return false; }
+        for (const auto& token : tokens) { if (token.rfind("TEMP=", 0) == 0) { return false; } }
+        const auto kind = tokens.front().front();
+        if (kind != 'R' && kind != 'L' && kind != 'B' && kind != 'I' && kind != 'V') { return false; }
+        if ((kind == 'I' || kind == 'V')
+            && (tokens.size() < 4 || (tokens.at(3) != "DC" && tokens.at(3).rfind("PWL(", 0) != 0))) { return false; }
+    }
+    return true;
+}
+
+void Simulation::capture(int64_t i, double step) {
+    if (!results.bounded) {
+        for (size_t j = 0; j < results.xVector.size(); ++j) {
+            if (results.xVector.at(j)) { results.xVector.at(j)->emplace_back(x_.at(j)); }
+        }
+        results.timeAxis.emplace_back(step);
+        return;
+    }
+    auto& row = results.rolling.at(static_cast<size_t>(i % 3));
+    std::copy_n(x_.begin(), row.size(), row.begin());
+    if (i != 0 && step < nextPrintPoint_) { return; }
+    if (results.timeAxis.size() >= Results::rowLimit) { throw std::runtime_error("History resource limit"); }
+    for (size_t j = 0; j < results.xVector.size(); ++j) {
+        if (!results.xVector.at(j)) { continue; }
+        for (int previous = 2; previous >= 0; --previous) {
+            const auto index = i < previous ? 0 : i - previous;
+            results.xVector.at(j)->emplace_back(results.rolling.at(static_cast<size_t>(index % 3)).at(j));
+        }
+    }
+    results.timeAxis.emplace_back(step);
+    if (i != 0) {
+        const double next = nextPrintPoint_ + prstep_;
+        if (!std::isfinite(next) || next <= nextPrintPoint_) { throw std::runtime_error("Print representation limit"); }
+        nextPrintPoint_ = next;
+    }
 }
 
