{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:laminarauth:backup-recovery-set:v2",
  "title": "Backup recovery set contract v2",
  "description": "Direct decrypt, validate and load. Structure alone does not prove actual creation or restoration. All references are local.",
  "oneOf": [{"$ref": "#/$defs/manifest"},{"$ref": "#/$defs/capture_readback"},{"$ref": "#/$defs/creation_result"},{"$ref": "#/$defs/final_result"}],
  "$defs": {
    "text": {"type": "string","minLength": 1,"pattern": "^[ -~]+$"},
    "id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string","pattern": "^[0-9a-f]{40}$"},
    "uint": {"type": "integer","minimum": 0,"maximum": 9007199254740991},
    "positive": {"type": "integer","minimum": 1,"maximum": 9007199254740991},
    "timestamp": {"type": "string","format": "date-time","pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "blob": {"type": "object","properties": {"sha256": {"$ref": "#/$defs/sha256"},"size": {"$ref": "#/$defs/positive"}},"required": ["sha256","size"],"additionalProperties": false},
    "recipient": {"type": "object","properties": {"key_id": {"$ref": "#/$defs/id"},"type": {"enum": ["age-x25519","age-plugin-yubikey-piv-p256-v0.5.1"]},"value": {"$ref": "#/$defs/text"},"fingerprint": {"$ref": "#/$defs/sha256"}},"required": ["key_id","type","value","fingerprint"],"additionalProperties": false,"allOf": [{"if": {"properties": {"type": {"const": "age-x25519"}}},"then": {"properties": {"value": {"pattern": "^age1[023456789acdefghjklmnpqrstuvwxyz]{58}$"}}},"else": {"properties": {"value": {"pattern": "^age1yubikey1[023456789acdefghjklmnpqrstuvwxyz]+$"}}}}]},
    "not_applicable": {"type": "object","properties": {"applicability": {"const": "not_applicable"},"reason": {"$ref": "#/$defs/text"}},"required": ["applicability","reason"],"additionalProperties": false},
    "app_scope": {"type": "object","properties": {"kind": {"const": "application"},"app_id": {"$ref": "#/$defs/id"},"org_id": {"$ref": "#/$defs/id"},"release_sha": {"$ref": "#/$defs/revision"}},"required": ["kind","app_id","org_id","release_sha"],"additionalProperties": false},
    "platform_scope": {"type": "object","properties": {"kind": {"const": "platform"},"cluster_id": {"$ref": "#/$defs/id"},"app_id": {"$ref": "#/$defs/not_applicable"},"org_id": {"$ref": "#/$defs/not_applicable"},"release_sha": {"$ref": "#/$defs/not_applicable"}},"required": ["kind","cluster_id","app_id","org_id","release_sha"],"additionalProperties": false},
    "context": {"type": "object","properties": {"set_id": {"$ref": "#/$defs/id"},"set_type": {"enum": ["wqs","laminarauth","platform"]},"scope": {"oneOf": [{"$ref": "#/$defs/app_scope"},{"$ref": "#/$defs/platform_scope"}]},"format_version": {"const": 1},"source": {"type": "object","properties": {"revision": {"$ref": "#/$defs/revision"},"image_or_executable_digest": {"$ref": "#/$defs/sha256"},"workload": {"$ref": "#/$defs/id"},"storage": {"$ref": "#/$defs/id"}},"required": ["revision","image_or_executable_digest","workload","storage"],"additionalProperties": false},"boundary": {"type": "object","properties": {"method": {"$ref": "#/$defs/text"},"cursor": {"$ref": "#/$defs/id"},"source_at": {"$ref": "#/$defs/timestamp"}},"required": ["method","cursor","source_at"],"additionalProperties": false},"recipients": {"type": "array","items": {"$ref": "#/$defs/recipient"},"minItems": 2},"recipients_digest": {"$ref": "#/$defs/blob"}},"required": ["set_id","set_type","scope","format_version","source","boundary","recipients","recipients_digest"],"additionalProperties": false,"allOf": [{"if": {"properties": {"set_type": {"const": "platform"}}},"then": {"properties": {"scope": {"$ref": "#/$defs/platform_scope"}}},"else": {"properties": {"scope": {"$ref": "#/$defs/app_scope"}}}}]},
    "path": {"type": "string","minLength": 1,"pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$"},
    "file": {"type": "object","properties": {"path": {"$ref": "#/$defs/path"},"kind": {"const": "regular"},"role": {"$ref": "#/$defs/id"},"sha256": {"$ref": "#/$defs/sha256"},"size": {"$ref": "#/$defs/uint"}},"required": ["path","kind","role","sha256","size"],"additionalProperties": false},
    "binding": {"type": "object","properties": {"record_id": {"$ref": "#/$defs/id"},"evidence_type": {"const": "manifest"},"schema_id": {"const": "backup-recovery-set-v2"},"contract_version": {"const": 2},"sha256": {"$ref": "#/$defs/sha256"},"size": {"$ref": "#/$defs/positive"}},"required": ["record_id","evidence_type","schema_id","contract_version","sha256","size"],"additionalProperties": false},
    "wqs_dependencies": {"type": "object","properties": {"kind": {"const": "wqs"},"database": {"$ref": "#/$defs/path"},"results": {"type": "array","items": {"$ref": "#/$defs/path"},"minItems": 0},"invitation_registry": {"$ref": "#/$defs/path"},"pending_delivery_key": {"$ref": "#/$defs/path"},"runner_ledger": {"$ref": "#/$defs/path"},"release_receipts": {"type": "array","items": {"$ref": "#/$defs/path"},"minItems": 0},"image_inventory": {"$ref": "#/$defs/path"},"registry_access": {"$ref": "#/$defs/path"},"pvc_identity": {"$ref": "#/$defs/id"},"parent_coordinated": {"type": "boolean"},"ledger_state": {"enum": ["holding","interrupted","failed","nonverified"]},"admission_held": {"type": "boolean"},"cd_enabled": {"type": "boolean"}},"required": ["kind","database","results","invitation_registry","pending_delivery_key","runner_ledger","release_receipts","image_inventory","registry_access","pvc_identity","parent_coordinated","ledger_state","admission_held","cd_enabled"],"additionalProperties": false},
    "projection": {"type": "object","properties": {"path": {"$ref": "#/$defs/path"},"schema": {"$ref": "#/$defs/id"},"sha256": {"$ref": "#/$defs/sha256"},"size": {"$ref": "#/$defs/positive"},"boundary": {"$ref": "#/$defs/id"},"source_workload": {"$ref": "#/$defs/id"}},"required": ["path","schema","sha256","size","boundary","source_workload"],"additionalProperties": false},
    "redis_dependencies": {"type": "object","properties": {"kind": {"const": "laminarauth"},"rdb": {"$ref": "#/$defs/path"},"aof_manifest": {"$ref": "#/$defs/path"},"aof_files": {"type": "array","items": {"$ref": "#/$defs/path"},"minItems": 1},"log_segments": {"type": "array","items": {"$ref": "#/$defs/path"},"minItems": 1},"log_start": {"$ref": "#/$defs/id"},"log_end": {"$ref": "#/$defs/id"},"coverage_validated": {"type": "boolean"},"expected_projection": {"$ref": "#/$defs/projection"}},"required": ["kind","rdb","aof_manifest","aof_files","log_segments","log_start","log_end","coverage_validated","expected_projection"],"additionalProperties": false},
    "platform_dependencies": {"type": "object","properties": {"kind": {"const": "platform"},"datastore": {"$ref": "#/$defs/path"},"datastore_mode": {"enum": ["sqlite","embedded_etcd","external"]},"server_token": {"$ref": "#/$defs/path"},"encryption": {"oneOf": [{"type": "object","properties": {"state": {"const": "enabled"},"config": {"$ref": "#/$defs/path"},"key_material": {"type": "array","items": {"$ref": "#/$defs/path"},"minItems": 1}},"required": ["state","config","key_material"],"additionalProperties": false},{"type": "object","properties": {"state": {"const": "disabled"},"disposition": {"$ref": "#/$defs/text"}},"required": ["state","disposition"],"additionalProperties": false}]},"runtime_inventory": {"$ref": "#/$defs/path"},"k3s_version": {"$ref": "#/$defs/text"},"owner_verified": {"type": "boolean"}},"required": ["kind","datastore","datastore_mode","server_token","encryption","runtime_inventory","k3s_version","owner_verified"],"additionalProperties": false},
    "manifest": {"type": "object","properties": {"schema_id": {"const": "backup-recovery-set-v2"},"contract_version": {"const": 2},"canonical_profile": {"const": "backup-json-v1"},"record_id": {"$ref": "#/$defs/id"},"context": {"$ref": "#/$defs/context"},"created_at": {"$ref": "#/$defs/timestamp"},"evidence_type": {"const": "manifest"},"inventory": {"type": "array","items": {"$ref": "#/$defs/file"},"minItems": 1},"dependencies": {"oneOf": [{"$ref": "#/$defs/wqs_dependencies"},{"$ref": "#/$defs/redis_dependencies"},{"$ref": "#/$defs/platform_dependencies"}]}},"required": ["schema_id","contract_version","canonical_profile","record_id","context","created_at","evidence_type","inventory","dependencies"],"additionalProperties": false},
    "capture_readback": {"type": "object","properties": {"schema_id": {"const": "backup-recovery-set-v2"},"contract_version": {"const": 2},"canonical_profile": {"const": "backup-json-v1"},"record_id": {"$ref": "#/$defs/id"},"context": {"$ref": "#/$defs/context"},"created_at": {"$ref": "#/$defs/timestamp"},"evidence_type": {"const": "capture_readback"},"manifest_ref": {"$ref": "#/$defs/binding"},"ciphertext": {"$ref": "#/$defs/blob"},"object_ref": {"$ref": "#/$defs/id"},"outcome": {"const": "readback_verified"}},"required": ["schema_id","contract_version","canonical_profile","record_id","context","created_at","evidence_type","manifest_ref","ciphertext","object_ref","outcome"],"additionalProperties": false},
    "final_result": {"oneOf": [{"type": "object","properties": {"evidence_type": {"const": "final_result"},"verified": {"const": true},"backup_id": {"$ref": "#/$defs/id"}},"required": ["evidence_type","verified","backup_id"],"additionalProperties": false},{"type": "object","properties": {"evidence_type": {"const": "final_result"},"verified": {"const": false},"backup_id": {"type": "null"},"failure": {"enum": ["unavailable","ineligible","timeout"]}},"required": ["evidence_type","verified","backup_id","failure"],"additionalProperties": false}]},
    "creation_result": {"oneOf": [{"type": "object","properties": {"evidence_type": {"const": "creation_result"},"backup_id": {"$ref": "#/$defs/id"},"created": {"const": true}},"required": ["evidence_type","created","backup_id"],"additionalProperties": false},{"type": "object","properties": {"evidence_type": {"const": "creation_result"},"backup_id": {"type": "null"},"failure": {"enum": ["unavailable","ineligible","timeout"]},"created": {"const": false}},"required": ["evidence_type","created","backup_id","failure"],"additionalProperties": false}]}
  }
}
